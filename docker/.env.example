# Copy to docker/.env (git-ignored) and adjust.
# Host directory that contains your CLike workspaces/projects; mounted read-only at the same path.
CLIKE_PROJECTS_DIR=/path/to/your/projects
# Memory cap of the eval sandbox (runs generated tests). Keep it below the container VM memory
# (Podman machine default: 2 GB → 1g) so a runaway test cannot get the orchestrator OOM-killed.
CLIKE_EVAL_SANDBOX_MEM_LIMIT=4g
# Promoted REQs regressed at the same time by an eval (1 = one after the other, max 8). Each one
# runs its own installs, tests and services: with a large frontend (npm build, browser tests) count
# about 1.5 GB per worker within CLIKE_EVAL_SANDBOX_MEM_LIMIT.
CLIKE_EVAL_REGRESSION_WORKERS=2
