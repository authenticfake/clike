# Copy to docker/.env (git-ignored) and adjust.
# Host directory that contains your CLike workspaces/projects; mounted read-only at the same path.
CLIKE_PROJECTS_DIR=/path/to/your/projects
# Memory cap of the eval sandbox (runs generated tests). Keep it below the container VM memory
# (Podman machine default: 2 GB → 1g) so a runaway test cannot get the orchestrator OOM-killed.
CLIKE_EVAL_SANDBOX_MEM_LIMIT=4g
# Promoted REQs regressed at the same time by an eval: auto (default) = what the sandbox sustains,
# about 2 GB and 2 CPUs per worker, at most 4 (4g → 2, 10g with 7 CPUs → 3); or a number
# (1 = one after the other, max 8). Each one runs its own installs, tests and services.
CLIKE_EVAL_REGRESSION_WORKERS=auto
# Free space (GB) an eval needs on the eval volume, and at least 15% of it: below it the work
# directories of the project's other evals are removed (reports and caches stay), then a warning.
CLIKE_EVAL_MIN_FREE_GB=10
